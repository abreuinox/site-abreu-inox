# Google Ads — copie para .env.local e preencha com os valores da conta.
# ID da tag: Ferramentas > Conversões > Tag do Google (formato AW-0000000000)
# Rótulo: ação de conversão "Clique WhatsApp" (a parte depois da barra)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Google Analytics 4 — ID de medição (formato G-XXXXXXXXXX). Usa a mesma tag do Google Ads.
NEXT_PUBLIC_GA_ID=

# Verificação por meta tag (opcional; a verificação por DNS dispensa estas variáveis).
# Search Console: só o valor do content da meta google-site-verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: valor do content da meta msvalidate.01.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
